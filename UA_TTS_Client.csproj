<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <Folder Include="Core\Enums\" />
        <Folder Include="Core\Interfaces\" />
        <Folder Include="Core\Models\" />
        <Folder Include="Infrastructure\Api\" />
        <Folder Include="Infrastructure\Audio\" />
        <Folder Include="Infrastructure\Automation\" />
        <Folder Include="Infrastructure\Parsing\" />
        <Folder Include="Infrastructure\Storage\" />
        <Folder Include="Models\"/>
        <AvaloniaResource Include="Assets\**"/>
        <Folder Include="Server_py\" />
        <Folder Include="ViewModels\Components\" />
        <Folder Include="ViewModels\Tabs\" />
        <Folder Include="Views\Tabs\" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.4" />
        <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2"/>
        <PackageReference Include="ManagedBass" Version="4.0.2" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.13" />
        <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.13" />
        <PackageReference Include="SharpHook" Version="8.0.0" />
        <PackageReference Include="System.Text.Json" Version="10.0.13" />
        <PackageReference Include="TextCopy" Version="6.2.1" />
    </ItemGroup>
</Project>
