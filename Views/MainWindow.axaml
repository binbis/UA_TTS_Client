<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:UA_TTS_Client.ViewModels"
        xmlns:conv="using:Avalonia.Data.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
        x:Class="UA_TTS_Client.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="UA TTS Client"
        Width="980" Height="680"
        MinWidth="760" MinHeight="520">

    <Window.Styles>
        <Style Selector="Ellipse.status-dot">
            <Setter Property="Fill" Value="#F85149" />
        </Style>
        <Style Selector="Ellipse.status-dot.online">
            <Setter Property="Fill" Value="#3FB950" />
        </Style>
        <Style Selector="Button.player">
            <Setter Property="MinWidth" Value="38" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="Foreground" Value="#8B949E" />
        </Style>
    </Window.Styles>

    <DockPanel>

        <!-- Верхня панель: назва та стан сервера -->
        <Border DockPanel.Dock="Top" Padding="16,10" BorderThickness="0,0,0,1" BorderBrush="#30363D">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="UA TTS Client"
                           FontSize="20"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Ellipse Classes="status-dot"
                             Classes.online="{Binding IsServerOnline}"
                             Width="10" Height="10"
                             VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ServerStatusText}"
                               VerticalAlignment="Center"
                               ToolTip.Tip="{Binding ServerDetails}" />
                    <Button Content="Перевірити" Command="{Binding RefreshServerStatusCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Нижня панель: міні-плеєр -->
        <Border DockPanel.Dock="Bottom" Padding="16,8" BorderThickness="0,1,0,0" BorderBrush="#30363D">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto">
                <Button Classes="player"
                        Content="{Binding Playback.PlayPauseGlyph}"
                        Command="{Binding Playback.TogglePlayPauseCommand}"
                        ToolTip.Tip="Пауза / продовжити" />

                <Button Grid.Column="1"
                        Classes="player"
                        Content="■"
                        Margin="6,0,0,0"
                        Command="{Binding Playback.StopCommand}"
                        ToolTip.Tip="Зупинити" />

                <TextBlock Grid.Column="2"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Text="{Binding Playback.StateText}" />

                <StackPanel Grid.Column="3"
                            Orientation="Horizontal"
                            Spacing="12"
                            Margin="16,0"
                            VerticalAlignment="Center">
                    <TextBlock Classes="hint"
                               Text="{Binding Playback.VoiceName}" />
                    <TextBlock Classes="hint"
                               Text="{Binding Playback.FragmentPositionText}"
                               IsVisible="{Binding Playback.FragmentPositionText, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>

                <TextBlock Grid.Column="4"
                           VerticalAlignment="Center"
                           Classes="hint"
                           Text="Гучність" />

                <Slider Grid.Column="5"
                        Width="160"
                        Margin="8,0,0,0"
                        Minimum="0"
                        Maximum="1"
                        TickFrequency="0.1"
                        IsSnapToTickEnabled="True"
                        Value="{Binding Playback.Volume}" />

                <TextBlock Grid.Column="6"
                           Width="40"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           Text="{Binding Playback.Volume, StringFormat='{}{0:0.0}'}" />
            </Grid>
        </Border>

        <!-- Центральна частина: вкладки -->
        <TabControl Margin="12,8" SelectedIndex="{Binding SelectedTabIndex}">
            <TabItem Header="Quick TTS">
                <ContentControl Content="{Binding QuickTts}" />
            </TabItem>
            <TabItem Header="Reader">
                <ContentControl Content="{Binding Reader}" />
            </TabItem>
            <TabItem Header="Character Voice">
                <ContentControl Content="{Binding CharacterVoice}" />
            </TabItem>
            <TabItem Header="Налаштування">
                <ContentControl Content="{Binding Settings}" />
            </TabItem>
        </TabControl>

    </DockPanel>
</Window>
